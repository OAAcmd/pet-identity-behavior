{
  "name": "pet-perception-web",
  "private": true,
  "version": "0.2.0",
  "description": "Mobile-first PWA for the observation-first pet behavior engine",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
