{
  "$defs": {
    "AnimalTrack": {
      "additionalProperties": false,
      "properties": {
        "track_id": {
          "title": "Track Id",
          "type": "string"
        },
        "identity_note": {
          "const": "per-analysis track label; not a verified pet identity",
          "default": "per-analysis track label; not a verified pet identity",
          "title": "Identity Note",
          "type": "string"
        },
        "species": {
          "enum": [
            "cat",
            "dog"
          ],
          "title": "Species",
          "type": "string"
        },
        "species_scores": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object"
          },
          "title": "Species Scores",
          "type": "object"
        },
        "score_kind": {
          "const": "detector_sigmoid_raw",
          "default": "detector_sigmoid_raw",
          "title": "Score Kind",
          "type": "string"
        },
        "first_seen_s": {
          "title": "First Seen S",
          "type": "number"
        },
        "last_seen_s": {
          "title": "Last Seen S",
          "type": "number"
        },
        "duration_s": {
          "title": "Duration S",
          "type": "number"
        },
        "n_detections": {
          "title": "N Detections",
          "type": "integer"
        },
        "missed_sampled_frames": {
          "title": "Missed Sampled Frames",
          "type": "integer"
        },
        "detections": {
          "items": {
            "$ref": "#/$defs/Detection"
          },
          "title": "Detections",
          "type": "array"
        },
        "movement": {
          "$ref": "#/$defs/MovementSummary"
        },
        "zones": {
          "items": {
            "$ref": "#/$defs/ZoneOccupancy"
          },
          "title": "Zones",
          "type": "array"
        },
        "pose_features": {
          "items": {
            "$ref": "#/$defs/PoseFeature"
          },
          "title": "Pose Features",
          "type": "array"
        },
        "quality_flags": {
          "items": {
            "type": "string"
          },
          "title": "Quality Flags",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "track_id",
        "species",
        "species_scores",
        "first_seen_s",
        "last_seen_s",
        "duration_s",
        "n_detections",
        "missed_sampled_frames",
        "detections",
        "movement"
      ],
      "title": "AnimalTrack",
      "type": "object"
    },
    "Attribution": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "unknown",
            "no_visible_animal",
            "single_visible_candidate",
            "video_unavailable"
