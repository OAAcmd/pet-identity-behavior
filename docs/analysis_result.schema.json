          "title": "Candidate Track Ids",
          "type": "array"
        },
        "method": {
          "const": "none_evaluated",
          "default": "none_evaluated",
          "title": "Method",
          "type": "string"
        },
        "note": {
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "status",
        "note"
      ],
      "title": "Attribution",
      "type": "object"
    },
    "AudioStream": {
      "additionalProperties": false,
