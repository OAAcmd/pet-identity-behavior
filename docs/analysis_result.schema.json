          "type": "string"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "name",
        "kind",
        "state"
      ],
      "title": "ComponentStatus",
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "supported_observation",
            "experimental_hypothesis",
            "abstention"
