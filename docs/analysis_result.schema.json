          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Bandwidth Hz"
        },
        "windows_scored": {
          "default": 0,
          "title": "Windows Scored",
          "type": "integer"
        }
      },
      "required": [
        "state"
      ],
      "title": "AudioSummary",
      "type": "object"
    },
    "ComponentStatus": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "enum": [
            "ingest",
            "audio_event",
            "visual_detector",
            "tracker",
            "pose",
            "context",
            "fusion",
            "explanation",
            "vlm"
          ],
          "title": "Kind",
          "type": "string"
        },
        "state": {
          "enum": [
            "ok",
            "unavailable",
            "disabled",
            "failed",
            "skipped",
            "not_applicable"
          ],
