          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "state",
        "overall_interpretation",
        "reason_codes",
        "summary"
      ],
      "title": "Decision",
      "type": "object"
    },
    "Detection": {
      "additionalProperties": false,
      "properties": {
        "t_s": {
          "title": "T S",
          "type": "number"
        },
        "box_xyxy_norm": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Box Xyxy Norm",
          "type": "array"
        },
        "species_scores": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Species Scores",
          "type": "object"
        },
        "flags": {
          "items": {
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        }
      },
      "required": [
        "t_s",
        "box_xyxy_norm",
        "species_scores"
      ],
      "title": "Detection",
      "type": "object"
    },
