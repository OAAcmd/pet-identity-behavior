        "state": {
          "title": "State",
          "type": "string"
        },
        "rms_dbfs": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rms Dbfs"
        },
        "peak_dbfs": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
