        "score_kind": {
          "enum": [
            "heuristic_support_0_1",
            "fusion_experimental_score_0_1",
            "none"
          ],
          "title": "Score Kind",
          "type": "string"
        },
        "scorer": {
          "$ref": "#/$defs/Scorer"
        },
        "calibration_status": {
          "default": "uncalibrated",
          "enum": [
            "uncalibrated",
            "calibrated",
            "not_applicable"
          ],
          "title": "Calibration Status",
          "type": "string"
        },
        "calibrated_confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calibrated Confidence"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "hypothesis_id",
        "name",
        "semantic_type",
        "status",
        "supporting_evidence_ids",
        "conflicting_evidence_ids",
        "independent_provenance_roots",
        "score_kind",
        "scorer",
        "explanation"
