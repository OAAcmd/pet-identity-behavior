        "multimodal_accuracy": {
          "const": "not_evaluated",
          "default": "not_evaluated",
          "title": "Multimodal Accuracy",
          "type": "string"
        },
        "weights_fitted": {
          "const": false,
          "default": false,
          "title": "Weights Fitted",
          "type": "boolean"
