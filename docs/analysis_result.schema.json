        "t_end_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "T End S"
        },
        "supporting_evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Evidence Ids",
          "type": "array"
        },
        "conflicting_evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Conflicting Evidence Ids",
          "type": "array"
        },
        "independent_provenance_roots": {
          "items": {
            "type": "string"
          },
          "title": "Independent Provenance Roots",
          "type": "array"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Experimental unitless support score; NOT a probability",
          "title": "Score"
