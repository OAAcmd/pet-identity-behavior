# Copy to deploy/.env and adjust. Never commit deploy/.env.
PETPERCEPTION_DOMAIN=localhost
PETPERCEPTION_HTTPS_PORT=443
PETPERCEPTION_HTTP_PORT=80
# research | personal_noncommercial | commercial (see manifests/resources.json and docs/ASSET_TERMS.md)
PETPERCEPTION_RELEASE_PROFILE=personal_noncommercial
# efficientdet_lite0_tfhub_v1 states Apache-2.0 in the file. efficientdet_lite0_mediapipe_v1 states no licence:
# research only until docs/ASSET_TERMS.md Q-M2 is answered and recorded in configs/release_approvals.yaml.
PETPERCEPTION_DETECTOR=efficientdet_lite0_tfhub_v1
PETPERCEPTION_WORKERS=2
PETPERCEPTION_NUM_THREADS=2
PETPERCEPTION_CPUS=4
PETPERCEPTION_MEMORY=4g
